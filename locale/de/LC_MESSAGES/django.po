msgid ""
"Your message could not be sent. Your draft is still here. Please try again."
msgstr ""
"Deine Nachricht konnte nicht gesendet werden. Dein Entwurf ist noch da. "
"Versuche es noch einmal."

#: templates/chats/workspace.html:4
msgid "Saving your message…"
msgstr "Deine Nachricht wird gespeichert …"

