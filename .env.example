# Real hosting configuration. Local ./bin/serve manages its own private key.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# Set only when your trusted proxy strips and sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY=1
POSTGRES_DB=femaktiv
POSTGRES_USER=femaktiv
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=femaktiv <hello@your-domain.example>

# Optional private live-chat prototype. This file is a reference, not auto-loaded.
FEMAKTIV_AI_MODE=placeholder
# Registration is closed; create testers and approve live chat in Django admin.
FEMAKTIV_SIGNUP_ENABLED=0
FEMAKTIV_LIVE_USER_HOURLY_LIMIT=30
FEMAKTIV_LIVE_DAILY_LIMIT=100
ANYMIZE_API_KEY=
ANYMIZE_MODEL=
# Set to 1 only after enabling account-level Zero Data Retention in Anymize.
ANYMIZE_ZDR_CONFIRMED=1
# Set to 1 only after disabling provider-side fallback models in Anymize.
ANYMIZE_FALLBACKS_DISABLED_CONFIRMED=0
